---
import Header from '../components/Header.astro';

interface Props {
	title: string;
	descrption?: string;
	image?: string;
}

const { title, descrption, image } = Astro.props;
---

<!doctype html>

<html lang="en">

	<head>

		<meta charset="UTF-8" />

		<meta
			name="description"
			content={descrption || "Astro Blog"}
		/>

		<meta
			name="viewport"
			content="width=device-width"
		/>

		<link
			rel="icon"
			type="image/svg+xml"
			href="/favicon.svg"
		/>

		<meta
			name="generator"
			content={Astro.generator}
		/>

		<meta
			property="og:image"
			content={image || ""}
		/>

		<title>{title}</title>

	</head>

	<body class="scroll-smooth bg-white text-black dark:bg-black dark:text-white transition-colors duration-300">

		<Header />

		<slot />

	</body>

</html>